<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="ug.audiocity.appvault" android:versionCode="2" android:versionName="1.1.0">
<uses-sdk android:minSdkVersion="30" android:targetSdkVersion="35"/>
<uses-permission android:name="android.permission.USE_BIOMETRIC"/>
<!-- Android 11+ package visibility: lets the vault list and open the apps that have a home-screen icon. -->
<queries><intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent></queries>
<application android:label="@string/app_name" android:theme="@android:style/Theme.Material.NoActionBar" android:allowBackup="false" android:icon="@drawable/icon" android:supportsRtl="true">
<activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity>
<!-- Home screen: lists every app except the vault's. Hidden apps only appear behind the fingerprint. -->
<activity android:name=".HomeActivity" android:label="AppVault Home" android:exported="true" android:launchMode="singleTask" android:taskAffinity="ug.audiocity.appvault.home" android:stateNotNeeded="true" android:clearTaskOnLaunch="true" android:excludeFromRecents="true" android:theme="@android:style/Theme.Material.Wallpaper.NoTitleBar" android:windowSoftInputMode="adjustNothing" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.HOME"/><category android:name="android.intent.category.DEFAULT"/></intent-filter></activity>
<activity android:name=".LockActivity" android:exported="false" android:launchMode="singleInstance" android:taskAffinity="" android:excludeFromRecents="true" android:noHistory="true" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"/>
<service android:name=".GuardService" android:exported="true" android:label="@string/guard_name" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"><intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter><meta-data android:name="android.accessibilityservice" android:resource="@xml/guard_config"/></service>
</application></manifest>
